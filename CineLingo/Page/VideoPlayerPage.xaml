<Page x:Class="CineLingo.Page.VideoPlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
      xmlns:local="clr-namespace:CineLingo.Page"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Focusable="True"
      Title="VideoPlayerPage">

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Label x:Name="TitleLbl"  Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Style="{DynamicResource LabelStyle}" Content="Медиаплеер"
               Padding="5,0,5,5" Margin="20" FontWeight="SemiBold" FontSize="16" BorderThickness="0,0,0,2"/>

        <Grid x:Name="PlayerContainer" Grid.Column="0" Grid.Row="1" Margin="0 0 20 10" Height="400">
            <vlc:VideoView x:Name="Player">
                <Border x:Name="ControlPanel" Background="Transparent" Padding="10" HorizontalAlignment="Stretch" Opacity="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <Button Name="OpenFolder" Click="OpenFolder_Click" Padding="5" Margin="0 0 10 0" Background="Transparent" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Height="24" Width="24" Source="/Images/folder.png"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PlayBtn" Click="PlayBtn_Click" Padding="5" Margin="0 0 10 0" Background="Transparent" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Height="24" Width="24" Source="/Images/play.png"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PauseBtn" Click="PauseBtn_Click" Padding="5" Margin="0 0 10 0" Background="Transparent" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Height="24" Width="24" Source="/Images/pause.png"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Name="StatusLbl" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="10,0" MinWidth="60" TextAlignment="Center">00:00:00</TextBlock>
                        <Slider x:Name="ProgressSlider" Maximum="1" Thumb.DragStarted="ProgressSlider_DragStarted" Thumb.DragCompleted="ProgressSlider_DragCompleted" ValueChanged="ProgressSlider_ValueChanged" VerticalAlignment="Center" Width="200"/>
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.5" Width="100" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                        <Button x:Name="FullscreenBtn" Click="FullscreenBtn_Click" Padding="5" Margin="0 0 10 0" Background="Transparent" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Height="24" Width="24" Source="/Images/fullScreenPlayer.png"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </vlc:VideoView>
        </Grid>
        <StackPanel x:Name="SubtitlePanel" Grid.Column="0" Grid.Row="2">
            <Button Name="OpenSubtitles" Click="OpenSubtitles_Click" Padding="5" Margin="0,20,0,0" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Height="24" Width="24" Source="/Images/folder.png"/>
                    <TextBlock Text="Открыть субтитры" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>

            <TextBox x:Name="SubtitlesTextBox" Style="{DynamicResource TextBoxStyle}" BorderThickness="0" Background="Transparent"
                     FontSize="16" Margin="0" Padding="2" IsReadOnly="True" SelectionChanged="SubtitlesTextBox_SelectionChanged"
                     ContextMenuOpening="SubtitlesTextBox_ContextMenuOpening" Width="699" Height="70">
                <TextBox.ContextMenu>
                    <ContextMenu x:Name="SubtitleContextMenu" Background="#252B2B" Foreground="#EFDFC5">
                        <MenuItem Header="Сохранить в словарь" Click="SaveToDictionaryMenuItem_Click">
                            <MenuItem.Icon>
                                <Image Source="/Images/folder.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>

            <Label x:Name="TranslationLabel" Style="{DynamicResource LabelStyle}" Content="Перевод:" 
                       FontSize="16" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" 
                       Background="Transparent" Padding="10"/>
        </StackPanel>

        <StackPanel x:Name="DictionaryPanel" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3">
            <TextBlock Text="Словарь" Style="{DynamicResource TextBlockStyle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ListView x:Name="DictionaryList" Background="Transparent" BorderThickness="0" ItemsSource="{Binding DictionaryItems}">
                <ListView.Style>
                    <Style TargetType="ListView">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count, ElementName=DictionaryList}" Value="0">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <TextBlock Text="Нет сохранённых слов для этого файла" Foreground="#8F8F8F"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Style>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0 5">
                            <TextBlock Text="{Binding WordOrPhrase}" Style="{DynamicResource TextBlockStyle}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Translation}" Style="{DynamicResource TextBlockStyle}" Margin="5,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>